/*
========================================================================================
    TT-seq Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    sample_sheet              = null
    single_end                = false
    
    // Output options  
    outdir                    = './results'
    publish_dir_mode          = 'copy'
    
    // Genome references
    genome                    = null
    star_index                = null
    gtf                       = null
    
    // Spike-in normalization options
    spike_in_genome           = null
    spike_in_index            = null  
    spike_in_gtf              = null
    spike_in_name             = 'spike_in'
    
    // Tool options
    star_ignore_sjdbgtf       = false
    star_twopassmode          = 'Basic'
    
    // Quality control
    skip_fastqc               = false
    skip_multiqc              = false
    
    // BigWig options
    bigwig_binsize            = 10
    normalize_bigwig          = true
    
    // Debug options
    debug_mode                = false
    debug_num_reads           = 10000
    
    // Max resource options
    max_cpus                  = 256
    max_memory                = '3041.GB'
    max_time                  = '240.h'
    
    // Help
    help                      = false
}

/*
========================================================================================
    Configs
========================================================================================
*/

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load functions
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            return obj
        }
    }
}

profiles {
    debug { 
        process.beforeScript = 'echo $HOSTNAME'
        params.debug_mode = true
        params.debug_num_reads = 10000
    }
    conda {
        params.enable_conda    = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    test { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
    
    // HPC profiles
    unc_longleaf {
        process {
            executor = 'slurm'
            time = 8.h
            cpus = 4
            memory = 8.GB
            errorStrategy = { task.exitStatus in [1,143,137,104,134,139,140] ? 'retry' : 'finish' }
            maxRetries = 2
            beforeScript = 'module load python/3.12.4'
            
            // Module loading for specific processes
            withName: SAMPLESHEET_CHECK {
                beforeScript = 'module load python/3.12.4'
            }
            withName: FASTQC {
                beforeScript = 'module load fastqc/0.12.1'
            }
            withName: STAR_ALIGN {
                beforeScript = 'module load star/2.7.11b samtools/1.22'
            }
            withName: STAR_ALIGN_SPIKE {
                beforeScript = 'module load star/2.7.11b samtools/1.22'
            }
            withName: SAMTOOLS_SORT {
                beforeScript = 'module load samtools/1.22'
            }
            withName: SAMTOOLS_INDEX {
                beforeScript = 'module load samtools/1.22'
            }
            withName: PICARD_MARKDUPLICATES {
                beforeScript = 'module load picard/3.1.1'
            }
            withName: BAMCOVERAGE {
                beforeScript = 'module load deeptools/3.5.5'
            }
            withName: EXTRACT_SPIKE_COUNTS {
                beforeScript = '''
                    module load r/4.5.0
                    R_LIB_PATH=~/R/x86_64-pc-linux-gnu-library/4.5
                    mkdir -p $R_LIB_PATH
                    if ! R -e "packageVersion('DESeq2')" > /dev/null 2>&1; then
                        R -e "install.packages('BiocManager', lib='$R_LIB_PATH')"
                        R -e "BiocManager::install('DESeq2', lib='$R_LIB_PATH')"
                    fi
                '''
            }
            withName: CALCULATE_SIZE_FACTORS {
                beforeScript = '''
                    module load r/4.5.0
                    R_LIB_PATH=~/R/x86_64-pc-linux-gnu-library/4.5
                    mkdir -p $R_LIB_PATH
                    if ! R -e "packageVersion('DESeq2')" > /dev/null 2>&1; then
                        R -e "install.packages('BiocManager', lib='$R_LIB_PATH')"
                        R -e "BiocManager::install('DESeq2', lib='$R_LIB_PATH')"
                    fi
                '''
            }
            withName: MULTIQC {
                beforeScript = 'module load multiqc/1.28'
            }
            
            withLabel:process_single {
                cpus = { check_max( 1, 'cpus' ) }
                memory = { check_max( 6.GB * task.attempt, 'memory' ) }
                time = { check_max( 4.h * task.attempt, 'time' ) }
            }
            withLabel:process_low {
                cpus = { check_max( 2 * task.attempt, 'cpus' ) }
                memory = { check_max( 12.GB * task.attempt, 'memory' ) }
                time = { check_max( 4.h * task.attempt, 'time' ) }
            }
            withLabel:process_medium {
                cpus = { check_max( 6 * task.attempt, 'cpus' ) }
                memory = { check_max( 36.GB * task.attempt, 'memory' ) }
                time = { check_max( 8.h * task.attempt, 'time' ) }
            }
            withLabel:process_high {
                cpus = { check_max( 12 * task.attempt, 'cpus' ) }
                memory = { check_max( 72.GB * task.attempt, 'memory' ) }
                time = { check_max( 16.h * task.attempt, 'time' ) }
            }
            withLabel:process_long {
                time = { check_max( 20.h * task.attempt, 'time' ) }
            }
            withLabel:process_high_memory {
                memory = { check_max( 200.GB * task.attempt, 'memory' ) }
            }
            
            // Queue selection based on memory requirements
            queue = { task.memory <= 4.GB ? 'interact' : task.memory <= 128.GB ? 'general' : 'bigmem' }
        }
        
        executor {
            name = 'slurm'
            queueSize = 25
            queueStatInterval = '1 min'
            submitRateLimit = '1 / 2 s'
        }
        
        params {
            max_memory = 3041.GB
            max_cpus = 256
            max_time = 240.h
        }
    }
    
    // Genome-specific profiles
    hg38 { 
        includeConfig 'conf/genomes/hg38.config'
    }
    mm10 { 
        includeConfig 'conf/genomes/mm10.config' 
    }
    hg38_yeast {
        includeConfig 'conf/genomes/hg38.config'
        includeConfig 'conf/genomes/yeast_spike.config'
    }
    mm10_yeast {
        includeConfig 'conf/genomes/mm10.config'
        includeConfig 'conf/genomes/yeast_spike.config'
    }
}

/*
========================================================================================
    Load modules config for DSL2 module specific options
========================================================================================
*/

includeConfig 'conf/modules.config'

/*
========================================================================================
    Nextflow Metrics & Reports
========================================================================================
*/

timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

manifest {
    name            = 'raab-lab/nascent_txn'
    author          = 'Jesse Raab Lab'
    homePage        = 'https://github.com/raab-lab/nascent_txn'
    description     = 'TT-seq processing pipeline for nascent transcription analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=21.10.3'
    version         = '1.0.0'
}
